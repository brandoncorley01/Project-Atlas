# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Legacy anon JWT or new publishable key (sb_publishable_…)
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret key sb_secret_… (Settings → API Keys) OR legacy service_role JWT (Legacy API keys tab)
# Never paste the anon/publishable key here.
SUPABASE_SERVICE_ROLE_KEY=your-sb-secret-or-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API
API_HOST=0.0.0.0
API_PORT=8012
# Production: your Vercel URL, e.g. https://project-atlas.vercel.app
CORS_ORIGINS=http://localhost:3000
CRON_SECRET=change-me-in-production

# Data providers (add as you integrate)
# Data providers
# Finnhub (free): https://finnhub.io/register — improves RSI, news catalysts, trend scoring
FINNHUB_API_KEY=
POLYGON_API_KEY=
# The Odds API (free tier: 500 credits/month per key at the-odds-api.com)
# Multiple keys (comma-separated) auto-failover when one runs out of credits.
# Example: ODDS_API_KEY=key1,key2,key3,key4,key5
# Production: paste the same comma-separated value into Render → ODDS_API_KEY (not committed to git).
ODDS_API_KEY=
# Minutes to reuse cached odds before spending credits (default 360).
ODDS_CACHE_TTL_MINUTES=10080
# Live Fetch: priority = US-core majors (credit-safe). full = every active sport (expensive).
ODDS_SCAN_SCOPE=priority
# Max leagues per live Fetch (1 credit each). Keep low.
ODDS_MAX_SPORTS_PER_SCAN=2
# Championship futures on live Fetch (extra credits). Keep false for day-to-day use.
ODDS_INCLUDE_FUTURES_ON_LIVE=false
# Hard lock Odds spend until keys recover. Options: cache_only | conservative | normal
ODDS_SPEND_MODE=cache_only
# Block live Fetch when remaining credits would drop below this reserve.
# Free keys are ~500/mo — keep this small (25). A value of 500 blocks ALL Fetch.
ODDS_MIN_CREDITS_RESERVE=25
# Atlas Insight / Search Odds prop pulls (0 = never spend Odds credits).
ODDS_INSIGHT_PROP_EVENTS=0
ODDS_INSIGHT_MIN_CREDITS_RESERVE=25
ODDS_SEARCH_PROP_EVENTS=0
ODDS_SEARCH_MIN_CREDITS_RESERVE=25
OPENAI_API_KEY=

# Sports Expert Intelligence Layer — analyst support under each Atlas pick
ATLAS_EXPERT_INTELLIGENCE_ENABLED=true
ATLAS_INTELLIGENCE_LEARNING_MODE=observe
ATLAS_MAX_EXPERT_CONFIDENCE_ADJUSTMENT=8
ATLAS_MAX_NEWS_CONFIDENCE_ADJUSTMENT=6
ATLAS_MAX_TOTAL_INTELLIGENCE_ADJUSTMENT=12

# Market & Options Intelligence
# fixture = simulated flow (always labelled simulated); yahoo_derived = delayed chain unusualness
ATLAS_MARKET_INTELLIGENCE_ENABLED=true
ATLAS_OPTIONS_FLOW_PROVIDER=fixture
ATLAS_OPTIONS_FLOW_ALLOW_SIMULATED=true
ATLAS_EXIT_SCORE_VERSION=exit_v1
ATLAS_OPTIONS_SCORE_VERSION=options_activity_v1

# App
ENVIRONMENT=development
DEFAULT_USER_ID=
