# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# API
API_HOST=0.0.0.0
API_PORT=8012
# Production: your Vercel URL, e.g. https://project-atlas.vercel.app
CORS_ORIGINS=http://localhost:3000
CRON_SECRET=change-me-in-production

# Data providers (add as you integrate)
# Data providers
# Finnhub (free): https://finnhub.io/register — improves RSI, news catalysts, trend scoring
FINNHUB_API_KEY=
POLYGON_API_KEY=
# The Odds API (free tier: 500 credits/month per key at the-odds-api.com)
# Multiple keys (comma-separated) auto-failover when one runs out of credits.
# Example: ODDS_API_KEY=key1,key2,key3
ODDS_API_KEY=
# Minutes to reuse cached odds before spending credits (default 30).
ODDS_CACHE_TTL_MINUTES=30
# Live scan: priority = NFL/NBA/MLB/NHL + top soccer/tennis (~12 leagues). full = every active sport.
ODDS_SCAN_SCOPE=priority
# Max sports leagues per live scan (1 credit each). 0 = no cap when scope is full.
ODDS_MAX_SPORTS_PER_SCAN=18
OPENAI_API_KEY=

# App
ENVIRONMENT=development
DEFAULT_USER_ID=
